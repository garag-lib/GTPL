  "vue": "<div><section v-if=\"active === 0\" class=\"bench-branch\" data-branch=\"0\"><div class=\"bench-row\" v-for=\"row in rows\" :key=\"row.id\" :data-row=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></section><section v-else-if=\"active === 1\" class=\"bench-branch\" data-branch=\"1\"><div class=\"bench-row\" v-for=\"row in rows\" :key=\"row.id\" :data-row=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></section><section v-else-if=\"active === 2\" class=\"bench-branch\" data-branch=\"2\"><div class=\"bench-row\" v-for=\"row in rows\" :key=\"row.id\" :data-row=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></section><section v-else-if=\"active === 3\" class=\"bench-branch\" data-branch=\"3\"><div class=\"bench-row\" v-for=\"row in rows\" :key=\"row.id\" :data-row=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></section><section v-else-if=\"active === 4\" class=\"bench-branch\" data-branch=\"4\"><div class=\"bench-row\" v-for=\"row in rows\" :key=\"row.id\" :data-row=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></section><section v-else-if=\"active === 5\" class=\"bench-branch\" data-branch=\"5\"><div class=\"bench-row\" v-for=\"row in rows\" :key=\"row.id\" :data-row=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></section><section v-else-if=\"active === 6\" class=\"bench-branch\" data-branch=\"6\"><div class=\"bench-row\" v-for=\"row in rows\" :key=\"row.id\" :data-row=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></section><section v-else-if=\"active === 7\" class=\"bench-branch\" data-branch=\"7\"><div class=\"bench-row\" v-for=\"row in rows\" :key=\"row.id\" :data-row=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></section><section v-else-if=\"active === 8\" class=\"bench-branch\" data-branch=\"8\"><div class=\"bench-row\" v-for=\"