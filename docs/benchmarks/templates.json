{
  "gtpl": "<div g-switch=\"active\"><section g-case=\"'0'\" class=\"bench-branch\" data-branch=\"0\"><template g-for=\"rows;index;row\"><div class=\"bench-row\" data-row=\"{{row.id}}\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></template></section><section g-case=\"'1'\" class=\"bench-branch\" data-branch=\"1\"><template g-for=\"rows;index;row\"><div class=\"bench-row\" data-row=\"{{row.id}}\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></template></section><section g-case=\"'2'\" class=\"bench-branch\" data-branch=\"2\"><template g-for=\"rows;index;row\"><div class=\"bench-row\" data-row=\"{{row.id}}\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></template></section><section g-case=\"'3'\" class=\"bench-branch\" data-branch=\"3\"><template g-for=\"rows;index;row\"><div class=\"bench-row\" data-row=\"{{row.id}}\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></template></section><section g-case=\"'4'\" class=\"bench-branch\" data-branch=\"4\"><template g-for=\"rows;index;row\"><div class=\"bench-row\" data-row=\"{{row.id}}\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></template></section><section g-case=\"'5'\" class=\"bench-branch\" data-branch=\"5\"><template g-for=\"rows;index;row\"><div class=\"bench-row\" data-row=\"{{row.id}}\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></template></section><section g-case=\"'6'\" class=\"bench-branch\" data-branch=\"6\"><template g-for=\"rows;index;row\"><div class=\"bench-row\" data-row=\"{{row.id}}\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></template></section><section g-case=\"'7'\" class=\"bench-branch\" data-branch=\"7\"><template g-for=\"rows;index;row\"><div class=\"bench-row\" data-row=\"{{row.id}}\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div></template></section><section g-case=\"'8'\" class=\"bench-branch\" data-branch=\"8\"><template g-for=\"rows;inde