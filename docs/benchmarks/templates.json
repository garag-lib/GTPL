  "angular": "<div>@switch (active) {@case (0) {<section class=\"bench-branch\" data-branch=\"0\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}@case (1) {<section class=\"bench-branch\" data-branch=\"1\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}@case (2) {<section class=\"bench-branch\" data-branch=\"2\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}@case (3) {<section class=\"bench-branch\" data-branch=\"3\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}@case (4) {<section class=\"bench-branch\" data-branch=\"4\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}@case (5) {<section class=\"bench-branch\" data-branch=\"5\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}@case (6) {<section class=\"bench-branch\" data-branch=\"6\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}@case (7) {<section class=\"bench-branch\" data-branch=\"7\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}@case (8) {<section class=\"bench-branch\" data-branch=\"8\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}@case (9) {<section class=\"bench-branch\" data-branch=\"9\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}@case (10) {<section class=\"bench-branch\" data-branch=\"10\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}@case (11) {<section class=\"bench-branch\" data-branch=\"11\">@for (row of rows; track row.id) {<div class=\"bench-row\" [attr.data-row]=\"row.id\"><span>{{row.id}}</span><b>{{row.label}}</b><i>{{tick}}</i></div>}</section>}}</div>"
