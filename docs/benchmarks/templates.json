  "alpine": "<div x-data=\"bench\"><template x-if=\"active === 0\"><section class=\"bench-branch\" data-branch=\"0\"><template x-for=\"row in rows\" :key=\"row.id\"><div class=\"bench-row\" :data-row=\"row.id\"><span x-text=\"row.id\"></span><b x-text=\"row.label\"></b><i x-text=\"tick\"></i></div></template></section></template><template x-if=\"active === 1\"><section class=\"bench-branch\" data-branch=\"1\"><template x-for=\"row in rows\" :key=\"row.id\"><div class=\"bench-row\" :data-row=\"row.id\"><span x-text=\"row.id\"></span><b x-text=\"row.label\"></b><i x-text=\"tick\"></i></div></template></section></template><template x-if=\"active === 2\"><section class=\"bench-branch\" data-branch=\"2\"><template x-for=\"row in rows\" :key=\"row.id\"><div class=\"bench-row\" :data-row=\"row.id\"><span x-text=\"row.id\"></span><b x-text=\"row.label\"></b><i x-text=\"tick\"></i></div></template></section></template><template x-if=\"active === 3\"><section class=\"bench-branch\" data-branch=\"3\"><template x-for=\"row in rows\" :key=\"row.id\"><div class=\"bench-row\" :data-row=\"row.id\"><span x-text=\"row.id\"></span><b x-text=\"row.label\"></b><i x-text=\"tick\"></i></div></template></section></template><template x-if=\"active === 4\"><section class=\"bench-branch\" data-branch=\"4\"><template x-for=\"row in rows\" :key=\"row.id\"><div class=\"bench-row\" :data-row=\"row.id\"><span x-text=\"row.id\"></span><b x-text=\"row.label\"></b><i x-text=\"tick\"></i></div></template></section></template><template x-if=\"active === 5\"><section class=\"bench-branch\" data-branch=\"5\"><template x-for=\"row in rows\" :key=\"row.id\"><div class=\"bench-row\" :data-row=\"row.id\"><span x-text=\"row.id\"></span><b x-text=\"row.label\"></b><i x-text=\"tick\"></i></div></template></section></template><template x-if=\"active === 6\"><section class=\"bench-branch\" data-branch=\"6\"><template x-for=\"row in rows\" :key=\"row.id\"><div class=\"bench-row\" :data-row=\"row.id\"><span x-text=